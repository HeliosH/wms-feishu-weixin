<view class="item-card card" bindtap="onTap">
  <view class="item-header">
    <text class="item-name">{{item.name}}</text>
    <text class="tag {{statusTagClass}}">{{statusLabel}}</text>
  </view>
  <view class="item-meta" wx:if="{{item.category_name}}">
    <text class="item-category">{{item.category_name}}</text>
  </view>
  <view class="item-stock">
    <view class="stock-item">
      <text class="stock-label">可用</text>
      <text class="stock-value available">{{item.available_quantity || 0}}</text>
    </view>
    <view class="stock-item">
      <text class="stock-label">借出</text>
      <text class="stock-value borrowed">{{item.borrowed_quantity || 0}}</text>
    </view>
    <view class="stock-item">
      <text class="stock-label">总计</text>
      <text class="stock-value total">{{item.total_quantity || 0}}</text>
    </view>
  </view>
</view>
