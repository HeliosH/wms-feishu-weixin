.filter-scroll {
  white-space: nowrap;
  background-color: #fff;
}

.filter-tabs {
  display: inline-flex;
  gap: 12rpx;
  padding: 16rpx 24rpx;
}

.filter-item {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 28rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
  background-color: #f5f5f5;
  flex-shrink: 0;
  transition: all 0.2s;
}

.filter-active {
  background-color: #1890ff;
  color: #fff;
}

.filter-badge {
  font-size: 20rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  border-radius: 14rpx;
  background-color: rgba(255, 255, 255, 0.3);
  padding: 0 6rpx;
}

.filter-active .filter-badge {
  background-color: rgba(255, 255, 255, 0.9);
  color: #1890ff;
}
