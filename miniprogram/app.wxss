/* ============================================================
   全局设计系统 · 简洁大方
   原则：单主色 / 中性灰阶 / 无渐变 / 轻阴影 / 统一圆角与按压反馈
   ============================================================ */
page {
  background-color: #f6f7f9;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

.container {
  padding: 20rpx 30rpx;
  min-height: 100vh;
}

/* ---------- 按压反馈（配合 hover-class 使用） ---------- */
.press {
  opacity: 0.65;
  transition: opacity 0.1s ease;
}

.press-scale {
  transform: scale(0.97);
  opacity: 0.85;
  transition: transform 0.12s ease, opacity 0.12s ease;
}

/* ---------- 按钮 ---------- */
.btn-primary {
  background-color: #1890ff;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  padding: 22rpx 0;
  text-align: center;
  border: none;
  line-height: 1.4;
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  background-color: #a8d4ff;
  color: rgba(255, 255, 255, 0.9);
}

.btn-danger {
  background-color: #ff4d4f;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  padding: 22rpx 0;
  text-align: center;
  border: none;
  line-height: 1.4;
}

.btn-danger::after {
  border: none;
}

.btn-success {
  background-color: #52c41a;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  padding: 22rpx 0;
  text-align: center;
  border: none;
  line-height: 1.4;
}

.btn-success::after {
  border: none;
}

.btn-default {
  background-color: #fff;
  color: #333;
  border: 1rpx solid #e5e6eb;
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 22rpx 0;
  text-align: center;
  line-height: 1.4;
}

.btn-default::after {
  border: none;
}

/* ---------- 卡片 ---------- */
.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.03);
}

/* ---------- 表单 ---------- */
.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.form-label {
  width: 180rpx;
  font-size: 28rpx;
  color: #666;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  height: 60rpx;
  padding: 0 12rpx;
}

/* ---------- 空状态 ---------- */
.empty-tip {
  text-align: center;
  color: #9aa0a6;
  font-size: 28rpx;
  padding: 100rpx 0;
}

/* ---------- 状态色 ---------- */
.status-pending { color: #faad14; }
.status-approved { color: #1890ff; }
.status-rejected { color: #ff4d4f; }
.status-collected { color: #52c41a; }
.status-returned { color: #8c8c8c; }

/* ---------- 分割线 ---------- */
.divider {
  height: 1rpx;
  background-color: #f2f3f5;
  margin: 16rpx 0;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  line-height: 1.6;
}

.tag-blue { background: #eef6ff; color: #1890ff; }
.tag-green { background: #f0f9eb; color: #52c41a; }
.tag-red { background: #fff1f0; color: #ff4d4f; }
.tag-orange { background: #fdf6ec; color: #fa8c16; }
.tag-gray { background: #f2f3f5; color: #8c8c8c; }
