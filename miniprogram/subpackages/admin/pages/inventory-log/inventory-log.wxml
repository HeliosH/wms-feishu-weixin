<view class="container">
  <view class="log-list">
    <view class="log-card card" wx:for="{{logs}}" wx:key="_id">
      <view class="log-header">
        <text class="log-item-name">{{item.item_name}}</text>
        <text class="tag {{item.changeTypeTag}}">{{item.changeTypeLabel}}</text>
      </view>
      <view class="log-row">
        <text class="log-label">变更数量</text>
        <text class="log-value">{{item.quantity}}</text>
      </view>
      <view class="log-row">
        <text class="log-label">库存变化</text>
        <text class="log-value">{{item.before_quantity}} → {{item.after_quantity}}</text>
      </view>
      <view class="log-row">
        <text class="log-label">原因</text>
        <text class="log-value">{{item.reason || '无'}}</text>
      </view>
      <view class="log-row">
        <text class="log-label">操作人</text>
        <text class="log-value">{{item.operator_name || '-'}}</text>
      </view>
      <view class="log-row">
        <text class="log-label">时间</text>
        <text class="log-value">{{item.created_at_str}}</text>
      </view>
    </view>
  </view>

  <view class="empty-tip" wx:if="{{logs.length === 0}}">暂无变更记录</view>
</view>
