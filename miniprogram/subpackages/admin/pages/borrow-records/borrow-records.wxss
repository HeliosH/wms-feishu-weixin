.page {
  padding: 20rpx 30rpx;
  min-height: 100vh;
}

/* ---------- 筛选 tabs ---------- */
.tab-bar {
  display: flex;
  white-space: nowrap;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 12rpx 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.03);
}

.tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 28rpx;
  margin: 0 6rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 28rpx;
  background-color: #f2f4f7;
}

.tab.active {
  color: #1890ff;
  background-color: #eef6ff;
  font-weight: 500;
}

/* ---------- 记录卡片 ---------- */
.record-card {
  padding: 24rpx;
}

.record-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.record-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.record-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
}

.record-label {
  font-size: 26rpx;
  color: #9aa0a6;
}

.record-value {
  font-size: 26rpx;
  color: #333;
}

.record-value.reject {
  color: #ff4d4f;
}

/* ---------- 空状态 ---------- */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-text {
  font-size: 26rpx;
  color: #9aa0a6;
  margin-top: 16rpx;
}
