.record-card { margin-bottom: 16rpx; }

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.record-item-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.record-row {
  display: flex;
  padding: 6rpx 0;
}

.record-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #999;
}

.record-value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.photo-section {
  margin: 16rpx 0;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
}

.photo-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.existing-photo {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
}

.record-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.action-btn {
  min-width: 180rpx;
  font-size: 26rpx;
}
