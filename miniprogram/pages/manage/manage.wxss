.page {
  padding: 20rpx 30rpx;
  padding-bottom: 220rpx;
  min-height: 100vh;
}

/* ===== 区域头部 ===== */
.section-header {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
  padding: 0 6rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.section-sub {
  font-size: 24rpx;
  color: #999;
  margin-left: 12rpx;
}

/* ===== 仓库总览 ===== */
.overview-section {
  margin-bottom: 24rpx;
}

.overview-scroll {
  white-space: nowrap;
  padding: 8rpx 0;
}

.overview-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 200rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 16rpx 20rpx;
  margin-right: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  white-space: normal;
  vertical-align: top;
}

.ov-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #fff7e6;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.ov-icon-text {
  font-size: 32rpx;
}

.ov-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
  margin-bottom: 14rpx;
}

.ov-stats {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.ov-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 12rpx;
}

.ov-divider {
  width: 1rpx;
  height: 36rpx;
  background: #f0f0f0;
}

.ov-num {
  font-size: 32rpx;
  font-weight: 700;
}

.ov-num.warn { color: #fa8c16; }

.ov-num.ok { color: #52c41a; }

.ov-label {
  font-size: 20rpx;
  color: #999;
  margin-top: 2rpx;
}

.ov-tip {
  font-size: 20rpx;
  color: #1890ff;
}

.overview-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 24rpx;
}

.empty-icon { font-size: 48rpx; margin-bottom: 10rpx; }
.empty-text { font-size: 26rpx; color: #999; }

/* ===== 库存管理 - 大按钮 ===== */
.big-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.big-card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 24rpx 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.big-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
}

.big-icon-text {
  font-size: 44rpx;
  color: #fff;
  font-weight: 600;
}

.add-bg {
  background: linear-gradient(135deg, #1890ff, #40a9ff);
  box-shadow: 0 6rpx 16rpx rgba(24, 144, 255, 0.25);
}

.adjust-bg {
  background: linear-gradient(135deg, #722ed1, #9254de);
  box-shadow: 0 6rpx 16rpx rgba(114, 46, 209, 0.25);
}

.big-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 6rpx;
}

.big-sub {
  font-size: 22rpx;
  color: #999;
}

/* 辅助入口 */
.aux-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.aux-card {
  display: flex;
  align-items: center;
}

.aux-icon-wrap {
  width: 60rpx;
  height: 60rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.aux-emoji {
  font-size: 30rpx;
}

.blue-bg  { background: #e6f7ff; }
.purple-bg { background: #f9f0ff; }
.orange-bg { background: #fff7e6; }
.red-bg    { background: #fff2f0; }

.aux-label {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.aux-arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* ===== 流程管理 ===== */
.flow-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.flow-card {
  display: flex;
  align-items: center;
}

.flow-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.flow-emoji {
  font-size: 30rpx;
}

.green-bg  { background: #f6ffed; }
.blue-bg   { background: #e6f7ff; }
.purple-bg { background: #f9f0ff; }
.orange-bg { background: #fff7e6; }
.red-bg    { background: #fff2f0; }

.flow-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.flow-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1a1a1a;
}

.flow-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.flow-badge {
  min-width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: #ff4d4f;
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 20rpx;
  padding: 0 12rpx;
  margin-right: 12rpx;
}

.flow-arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* ===== 角色管理 ===== */
.role-header {
  margin-top: 24rpx;
}

.user-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-row {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: #e8e8e8;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.user-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.user-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
  margin-bottom: 6rpx;
}

.user-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}

.user-arrow {
  font-size: 32rpx;
  color: #ccc;
  margin-left: 8rpx;
}

/* ===== 子 Tab 栏 ===== */
.sub-tab-bar {
  position: fixed;
  bottom: 100rpx;
  left: 0;
  right: 0;
  background: #fff;
  display: flex;
  border-top: 1rpx solid #f0f0f0;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 10;
}

.sub-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  position: relative;
  font-size: 28rpx;
  color: #999;
  font-weight: 500;
}

.sub-tab.active {
  color: #1890ff;
  font-weight: 600;
}

.sub-tab.active::after {
  content: '';
  position: absolute;
  top: 0;
  left: 25%;
  right: 25%;
  height: 4rpx;
  background: #1890ff;
  border-radius: 0 0 2rpx 2rpx;
}

.sub-dot {
  position: absolute;
  top: 10rpx;
  right: calc(50% - 60rpx);
  width: 14rpx;
  height: 14rpx;
  background: #ff4d4f;
  border-radius: 50%;
}

/* ===== 弹窗 ===== */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
}

.modal-title {
  display: flex;
  flex-direction: column;
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 30rpx;
}

.modal-sub {
  font-size: 26rpx;
  color: #999;
  font-weight: 400;
  margin-top: 4rpx;
}

.role-check-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.role-check-item {
  display: flex;
  align-items: center;
}

.role-check-label {
  font-size: 30rpx;
  color: #333;
  margin-left: 16rpx;
}

.role-hint {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.modal-btn {
  flex: 1;
  font-size: 30rpx;
  border-radius: 14rpx;
  padding: 22rpx 0;
  text-align: center;
}

.modal-btn::after { border: none; }
