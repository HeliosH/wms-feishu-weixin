.log-card { margin-bottom: 16rpx; }

.log-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.log-item-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.log-row {
  display: flex;
  padding: 6rpx 0;
}

.log-label {
  width: 140rpx;
  font-size: 24rpx;
  color: #999;
}

.log-value {
  flex: 1;
  font-size: 24rpx;
  color: #333;
}
