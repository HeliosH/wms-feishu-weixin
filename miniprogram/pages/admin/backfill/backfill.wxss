.card-title { font-size: 32rpx; font-weight: bold; color: #333; margin-bottom: 10rpx; }
.card-desc { font-size: 24rpx; color: #999; margin-bottom: 20rpx; display: block; }

.form-item { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.form-item.vertical { flex-direction: column; align-items: flex-start; }

.form-label { width: 160rpx; font-size: 28rpx; color: #666; }

.form-input { flex: 1; font-size: 28rpx; }
.form-textarea { width: 100%; min-height: 120rpx; font-size: 28rpx; margin-top: 12rpx; padding: 16rpx; background-color: #fafafa; border-radius: 8rpx; box-sizing: border-box; }

.picker-val { font-size: 28rpx; color: #333; }
.picker-val.placeholder { color: #c0c0c0; }

.photo-section { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #f0f0f0; }
.photo-hint { font-size: 22rpx; color: #ff4d4f; display: block; margin-bottom: 16rpx; }

.photo-area { width: 300rpx; height: 300rpx; border-radius: 8rpx; overflow: hidden; }
.photo-preview { width: 100%; height: 100%; }
.photo-placeholder {
  width: 100%; height: 100%;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  background-color: #fafafa;
  border: 2rpx dashed #d9d9d9; border-radius: 8rpx;
}
.photo-icon { font-size: 48rpx; color: #999; }
.photo-text { font-size: 22rpx; color: #999; margin-top: 6rpx; }

.submit-btn { margin-top: 40rpx; }
