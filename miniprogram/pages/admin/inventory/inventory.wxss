.page {
  padding: 20rpx 30rpx;
  padding-bottom: 160rpx;
  min-height: 100vh;
}

/* 搜索 */
.search-bar {
  margin-bottom: 16rpx;
}

.search-input {
  background: #fff;
  border-radius: 14rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* 分类筛选 */
.category-filter {
  white-space: nowrap;
  margin-bottom: 16rpx;
  padding: 4rpx 0;
}

.filter-tag {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 12rpx;
  background: #fff;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}

.filter-tag.active {
  background: #1890ff;
  color: #fff;
}

/* 货物列表 */
.item-row {
  display: flex;
  margin-bottom: 16rpx;
}

.item-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: #fff7e6;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.item-emoji { font-size: 34rpx; }

.item-body {
  flex: 1;
  overflow: hidden;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.item-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 4rpx;
}

.item-cat {
  font-size: 22rpx;
  color: #999;
  background: #f5f5f5;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.item-stock-info {
  font-size: 24rpx;
  color: #999;
}

.stock-num {
  color: #52c41a;
  font-weight: 600;
}

.item-stock-info.borrowed {
  color: #fa8c16;
}

/* 调整控件 */
.adjust-row {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.adjust-controls {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.ctrl-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.ctrl-btn.minus {
  background: #ff4d4f;
}

.ctrl-btn.plus {
  background: #52c41a;
}

.ctrl-input {
  width: 80rpx;
  height: 56rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  background: #fff;
}

.reason-input {
  flex: 1;
  height: 56rpx;
  font-size: 24rpx;
  background: #fafafa;
  border-radius: 12rpx;
  padding: 0 16rpx;
}

/* 底部提交栏 */
.submit-bar {
  position: fixed;
  bottom: 100rpx;
  left: 0;
  right: 0;
  z-index: 10;
  padding: 0 20rpx 20rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.submit-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to top, rgba(255,255,255,1) 60%, rgba(255,255,255,0));
  pointer-events: none;
}

.submit-inner {
  position: relative;
  display: flex;
  align-items: center;
  background: #1a1a1a;
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.15);
}

.submit-summary {
  display: flex;
  align-items: center;
  flex: 1;
}

.summary-item {
  display: flex;
  flex-direction: column;
}

.summary-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.1;
}

.summary-num.positive { color: #73d13d; }
.summary-num.negative { color: #ff7875; }

.summary-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.45);
  margin-top: 2rpx;
}

.summary-divider {
  width: 1rpx;
  height: 44rpx;
  background: rgba(255,255,255,0.15);
  margin: 0 28rpx;
}

.submit-btn {
  flex-shrink: 0;
  padding: 20rpx 40rpx;
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%);
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 新增按钮 */
.fab {
  position: fixed;
  bottom: 180rpx;
  right: 30rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #1890ff, #40a9ff);
  box-shadow: 0 6rpx 20rpx rgba(24, 144, 255, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9;
}

.fab text {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  width: 620rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 28rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-label {
  width: 140rpx;
  font-size: 28rpx;
  color: #999;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
}

.picker-val {
  font-size: 28rpx;
  color: #333;
}

.picker-val.placeholder { color: #ccc; }

.modal-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.modal-btn {
  flex: 1;
  font-size: 30rpx;
  border-radius: 14rpx;
  padding: 22rpx 0;
  text-align: center;
}

.modal-btn::after { border: none; }
