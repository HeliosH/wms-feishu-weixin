<view class="container">
  <view class="category-list">
    <view class="category-card card" wx:for="{{categories}}" wx:key="_id">
      <view class="category-info">
        <text class="category-name">{{item.name}}</text>
        <text class="category-desc">{{item.description || '无描述'}}</text>
      </view>
      <view class="category-actions">
        <text class="action-btn edit" bindtap="onEdit" data-index="{{index}}">编辑</text>
        <text class="action-btn delete" bindtap="onDelete" data-id="{{item._id}}" data-name="{{item.name}}">删除</text>
      </view>
    </view>
  </view>

  <view class="empty-tip" wx:if="{{categories.length === 0}}">暂无货物类型</view>

  <!-- 新增按钮 -->
  <view class="fab" bindtap="onAdd">+</view>

  <!-- 编辑弹窗 -->
  <view class="modal-mask" wx:if="{{showModal}}" bindtap="onCloseModal">
    <view class="modal-content" catchtap="">
      <view class="modal-title">{{isEdit ? '编辑类型' : '新增类型'}}</view>
      <view class="form-item">
        <text class="form-label">名称</text>
        <input class="form-input" placeholder="请输入类型名称" value="{{formName}}" bindinput="onNameInput" />
      </view>
      <view class="form-item vertical">
        <text class="form-label">描述</text>
        <textarea class="form-textarea" placeholder="请输入描述" value="{{formDesc}}" bindinput="onDescInput" />
      </view>
      <view class="modal-btns">
        <button class="btn-default modal-btn" bindtap="onCloseModal">取消</button>
        <button class="btn-primary modal-btn" bindtap="onSave">保存</button>
      </view>
    </view>
  </view>
</view>
