<view class="page">
  <!-- 待申请权限 -->
  <view class="apply-banner card" wx:if="{{needApplyRole}}" hover-class="press" bindtap="goApplyRole">
    <view class="apply-icon-box">
      <icon name="lock" size="40" />
    </view>
    <view class="apply-text">
      <text class="apply-title">申请借用权限</text>
      <text class="apply-desc">您还没有借用权限，点击申请</text>
    </view>
    <text class="apply-arrow">›</text>
  </view>

  <!-- 我的借用物品 -->
  <view class="section" wx:if="{{!needApplyRole}}">
    <view class="section-header">
      <text class="section-title">我借用的物品</text>
      <text class="section-count" wx:if="{{myItems.length > 0}}">{{myItems.length}} 件</text>
    </view>

    <view class="my-items" wx:if="{{myItems.length > 0}}">
      <view class="my-item card" wx:for="{{myItems}}" wx:key="_id">
        <view class="my-item-icon-box">
          <icon name="box" size="40" color="#9aa0a6" />
        </view>
        <view class="my-item-info">
          <text class="my-item-name">{{item.item_name}}</text>
          <text class="my-item-time">领取于 {{item.collectTimeStr || '--'}}</text>
        </view>
        <view class="my-item-qty">x{{item.quantity}}</view>
      </view>
    </view>

    <view class="my-items-empty card" wx:elif="{{!myItemsLoading}}">
      <icon name="inbox" size="72" color="#c9cdd4" />
      <text class="empty-text">暂无借用的物品</text>
      <text class="empty-hint">点击下方「借」开始借用</text>
    </view>
  </view>

  <!-- 核心操作按钮 -->
  <view class="action-buttons" wx:if="{{!needApplyRole}}">
    <view class="action-btn borrow-btn" hover-class="press-scale" hover-stay-time="80" bindtap="goBorrow">
      <view class="btn-icon-rect borrow-rect">
        <text class="btn-icon-text">借</text>
      </view>
      <text class="btn-title">申请借用</text>
      <text class="btn-desc">选择物品 · 拍照留档</text>
    </view>
    <view class="action-btn return-btn" hover-class="press-scale" hover-stay-time="80" bindtap="goReturn">
      <view class="btn-icon-rect return-rect">
        <text class="btn-icon-text">还</text>
      </view>
      <text class="btn-title">归还物品</text>
      <text class="btn-desc">确认归还 · 拍照留档</text>
    </view>
  </view>

  <!-- 辅助功能 -->
  <view class="aux-section" wx:if="{{!needApplyRole}}">
    <view class="aux-item card" hover-class="press" bindtap="goInTransit">
      <view class="aux-left">
        <view class="aux-icon-box">
          <icon name="refresh" size="40" />
        </view>
        <view class="aux-text">
          <text class="aux-title">在途流程</text>
          <text class="aux-desc">审批中、待领取、待归还</text>
        </view>
      </view>
      <text class="aux-arrow">›</text>
    </view>
    <view class="aux-item card" hover-class="press" bindtap="goHistory">
      <view class="aux-left">
        <view class="aux-icon-box">
          <icon name="clock" size="40" />
        </view>
        <view class="aux-text">
          <text class="aux-title">借用记录</text>
          <text class="aux-desc">查看所有历史借用</text>
        </view>
      </view>
      <text class="aux-arrow">›</text>
    </view>
  </view>
</view>
