.search-bar {
  margin-bottom: 16rpx;
}

.search-input {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.category-filter {
  white-space: nowrap;
  margin-bottom: 16rpx;
  padding: 8rpx 0;
}

.filter-item {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  background-color: #fff;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666;
}

.filter-item.active {
  background-color: #1890ff;
  color: #fff;
}

.item-card {
  display: flex;
  flex-direction: column;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.item-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.item-stock {
  display: flex;
  gap: 24rpx;
}

.stock-info {
  font-size: 24rpx;
  color: #666;
}

.stock-info.borrowed {
  color: #faad14;
}
