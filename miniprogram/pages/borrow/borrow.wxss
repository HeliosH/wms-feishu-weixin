.page {
  padding: 20rpx 30rpx;
  padding-bottom: 140rpx;
  min-height: 100vh;
}

/* ===== 申请权限横幅（扁平简洁） ===== */
.apply-banner {
  display: flex;
  align-items: center;
  background: #eef6ff;
  border: none;
}

.apply-icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: rgba(24, 144, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.apply-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.apply-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.apply-desc {
  font-size: 24rpx;
  color: #8c9aa8;
  margin-top: 4rpx;
}

.apply-arrow {
  font-size: 36rpx;
  color: #b8c4cf;
}

/* ===== 借用物品区域 ===== */
.section {
  margin-top: 24rpx;
}

.section-header {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
  padding: 0 6rpx;
}

.section-title {
  font-size: 26rpx;
  color: #9aa0a6;
  font-weight: 500;
}

.section-count {
  font-size: 24rpx;
  color: #1890ff;
  margin-left: 12rpx;
  background: #eef6ff;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.my-item {
  display: flex;
  align-items: center;
}

.my-item-icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: #f2f4f7;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.my-item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.my-item-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1a1a1a;
}

.my-item-time {
  font-size: 24rpx;
  color: #9aa0a6;
  margin-top: 4rpx;
}

.my-item-qty {
  font-size: 32rpx;
  font-weight: 600;
  color: #1890ff;
}

.my-items-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #9aa0a6;
  margin-top: 16rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #c9cdd4;
  margin-top: 8rpx;
}

/* ===== 核心操作按钮（扁平 · 双色 · 大点击区） ===== */
.action-buttons {
  display: flex;
  margin-top: 36rpx;
  gap: 24rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 20rpx 32rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.03);
}

.btn-icon-rect {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
}

.borrow-rect {
  background: #1890ff;
}

.return-rect {
  background: #52c41a;
}

.btn-icon-text {
  font-size: 44rpx;
  color: #fff;
  font-weight: 600;
}

.btn-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 6rpx;
}

.btn-desc {
  font-size: 22rpx;
  color: #9aa0a6;
}

/* ===== 辅助功能 ===== */
.aux-section {
  margin-top: 36rpx;
}

.aux-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.aux-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.aux-icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: #f2f4f7;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.aux-text {
  display: flex;
  flex-direction: column;
}

.aux-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1a1a1a;
}

.aux-desc {
  font-size: 24rpx;
  color: #9aa0a6;
  margin-top: 4rpx;
}

.aux-arrow {
  font-size: 36rpx;
  color: #c9cdd4;
}
