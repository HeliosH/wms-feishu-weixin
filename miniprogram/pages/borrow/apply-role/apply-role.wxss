.card-title { font-size: 32rpx; font-weight: bold; color: #333; margin-bottom: 10rpx; }
.card-desc { font-size: 24rpx; color: #999; margin-bottom: 24rpx; display: block; }

.form-item { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.form-label { width: 120rpx; font-size: 28rpx; color: #666; }
.form-input { flex: 1; font-size: 28rpx; }

.status-card { display: flex; align-items: center; margin-top: 30rpx; }
.status-icon { font-size: 40rpx; margin-right: 16rpx; }
.status-text { font-size: 28rpx; color: #333; }

.submit-btn { margin-top: 40rpx; }
