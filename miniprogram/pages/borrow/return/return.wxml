<view class="page">
  <view class="section" wx:if="{{!returning}}">
    <view class="section-header">
      <text class="section-title">选择要归还的物品</text>
      <text class="section-count" wx:if="{{items.length > 0}}">{{items.length}} 件</text>
    </view>

    <view class="item-list" wx:if="{{items.length > 0}}">
      <view class="return-item card" wx:for="{{items}}" wx:key="_id" bindtap="selectItem" data-id="{{item._id}}">
        <view class="item-icon-wrap">
          <text class="item-emoji">📦</text>
        </view>
        <view class="item-info">
          <text class="item-name">{{item.item_name}}</text>
          <text class="item-meta">数量 {{item.quantity}} · 已领取</text>
        </view>
        <text class="item-arrow">归还 ›</text>
      </view>
    </view>

    <view class="empty" wx:elif="{{!loading}}">
      <text class="empty-icon">🎉</text>
      <text class="empty-title">没有待归还的物品</text>
    </view>
  </view>

  <view class="confirm-section" wx:if="{{returning}}">
    <view class="card">
      <text class="confirm-title">确认归还</text>
      <text class="confirm-desc">请拍摄归还物品的照片作为留档</text>

      <view class="photo-area" bindtap="takePhoto">
        <image class="photo-preview" wx:if="{{photoUrl}}" src="{{photoUrl}}" mode="aspectFill" />
        <view class="photo-placeholder" wx:else>
          <view class="photo-icon-wrap">
            <text>+</text>
          </view>
          <text class="photo-hint">点击拍照</text>
        </view>
      </view>

      <view class="confirm-actions">
        <button class="btn-cancel" bindtap="cancelReturn">取消</button>
        <button class="btn-confirm" bindtap="confirmReturn" disabled="{{!photoUrl}}">确认归还</button>
      </view>
    </view>
  </view>
</view>
