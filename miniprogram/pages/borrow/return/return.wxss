.page {
  padding: 20rpx 30rpx;
  min-height: 100vh;
}

.section-header {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
  padding: 0 6rpx;
}

.section-title {
  font-size: 28rpx;
  color: #999;
  font-weight: 500;
}

.section-count {
  font-size: 24rpx;
  color: #52c41a;
  margin-left: 12rpx;
  background: #f6ffed;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
}

.return-item {
  display: flex;
  align-items: center;
}

.item-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: #fff7e6;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.item-emoji {
  font-size: 36rpx;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.item-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1a1a1a;
}

.item-meta {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.item-arrow {
  font-size: 26rpx;
  color: #52c41a;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon { font-size: 72rpx; margin-bottom: 20rpx; }
.empty-title { font-size: 30rpx; color: #333; font-weight: 500; }

.confirm-section { padding-top: 20rpx; }

.confirm-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
  margin-bottom: 8rpx;
}

.confirm-desc {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 24rpx;
}

.photo-area {
  width: 100%;
  height: 400rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #fafafa;
  border: 2rpx dashed #d9d9d9;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-preview { width: 100%; height: 100%; }

.photo-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.photo-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #ccc;
  margin-bottom: 16rpx;
}

.photo-hint { font-size: 24rpx; color: #ccc; }

.confirm-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.btn-cancel {
  flex: 1;
  background: #f5f5f5;
  color: #666;
  font-size: 30rpx;
  border-radius: 14rpx;
  padding: 22rpx 0;
  text-align: center;
  border: none;
}

.btn-cancel::after { border: none; }

.btn-confirm {
  flex: 2;
  background: linear-gradient(135deg, #52c41a, #73d13d);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 14rpx;
  padding: 22rpx 0;
  text-align: center;
  border: none;
}

.btn-confirm::after { border: none; }
.btn-confirm[disabled] { opacity: 0.5; }
