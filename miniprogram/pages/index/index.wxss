/* ============ 首页 · 角色仪表盘 ============ */

/* ---------- 顶部用户栏 ---------- */
.user-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background-color: #f2f3f5;
}

.user-text {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.logout-btn {
  font-size: 26rpx;
  color: #9aa0a6;
  padding: 10rpx 24rpx;
  border: 1rpx solid #e5e6eb;
  border-radius: 28rpx;
}

/* ---------- 区块标题 ---------- */
.section-title {
  font-size: 26rpx;
  color: #9aa0a6;
  margin: 30rpx 0 16rpx;
  padding-left: 8rpx;
}

/* ---------- 统计卡（三列） ---------- */
.stats-card {
  display: flex;
  align-items: stretch;
  padding: 32rpx 0;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.stat-num {
  font-size: 56rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.2;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

.stat-sub {
  font-size: 20rpx;
  color: #c9cdd4;
  margin-top: 4rpx;
}

.stat-divider {
  width: 1rpx;
  background-color: #f2f3f5;
  margin: 8rpx 0;
}

/* ---------- 统计卡（2x2 网格，管理员） ---------- */
.stats-grid {
  flex-wrap: wrap;
  padding: 0;
}

.stats-grid .grid-item {
  flex: none;
  width: 50%;
  padding: 32rpx 0;
  box-sizing: border-box;
}

/* ---------- 统计卡提示 ---------- */
.stat-hint {
  text-align: center;
  font-size: 22rpx;
  color: #c9cdd4;
  margin-top: -8rpx;
  margin-bottom: 24rpx;
}

/* ---------- 主操作按钮行 ---------- */
.action-row {
  display: flex;
  margin-top: 30rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 10rpx;
}

.action-btn icon {
  margin-right: 10rpx;
}

.action-btn-wide {
  max-width: 100%;
}

/* ---------- 列表入口卡片 ---------- */
.list-card {
  padding: 0;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 26rpx 24rpx;
  border-bottom: 1rpx solid #f2f3f5;
}

.list-item:last-child {
  border-bottom: none;
}

.list-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background-color: #f2f4f7;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.list-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.badge-sm {
  background-color: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 16rpx;
  padding: 0 8rpx;
  margin-right: 12rpx;
}

/* ---------- 更多入口 ---------- */
.more-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
  font-size: 26rpx;
  color: #9aa0a6;
}

.more-entry icon {
  margin-left: 6rpx;
}

/* ---------- 无权限空状态 ---------- */
.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  margin-top: 40rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-top: 24rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #9aa0a6;
  margin-top: 12rpx;
  margin-bottom: 40rpx;
}

.empty-btn {
  width: 100%;
}
