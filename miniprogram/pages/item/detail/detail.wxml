<view class="container">
  <!-- 货物基本信息 -->
  <view class="card">
    <view class="detail-header">
      <text class="detail-name">{{item.name}}</text>
      <text class="tag {{item.status === 'active' ? 'tag-green' : 'tag-gray'}}">{{item.status === 'active' ? '在库' : '停用'}}</text>
    </view>

    <view class="detail-row">
      <text class="detail-label">类型</text>
      <text class="detail-value">{{item.category_name || '未分类'}}</text>
    </view>
    <view class="detail-row">
      <text class="detail-label">描述</text>
      <text class="detail-value">{{item.description || '无'}}</text>
    </view>

    <view class="stock-bar">
      <view class="stock-block">
        <text class="stock-num available">{{item.available_quantity || 0}}</text>
        <text class="stock-label">可用</text>
      </view>
      <view class="stock-block">
        <text class="stock-num borrowed">{{item.borrowed_quantity || 0}}</text>
        <text class="stock-label">借出</text>
      </view>
      <view class="stock-block">
        <text class="stock-num total">{{item.total_quantity || 0}}</text>
        <text class="stock-label">总计</text>
      </view>
    </view>
  </view>

  <!-- 管理员功能 -->
  <block wx:if="{{isWarehouseAdmin}}">
    <!-- 当前借用人 -->
    <view class="card" wx:if="{{borrowers.length > 0}}">
      <view class="card-title">当前借用人</view>
      <view class="borrower-item" wx:for="{{borrowers}}" wx:key="_id">
        <text class="borrower-name">{{item.borrower_name}}</text>
        <text class="borrower-qty">借出 {{item.quantity}} 件</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-bar">
      <button class="btn-primary" bindtap="goAdjust">库存调整</button>
      <button class="btn-default" bindtap="goLog">变更记录</button>
      <button class="btn-default" bindtap="goBorrowers">借用人详情</button>
    </view>
  </block>

  <!-- 借用人员功能 -->
  <block wx:if="{{item.status === 'active' && item.available_quantity > 0}}">
    <view class="borrow-bar">
      <button class="btn-primary btn-borrow" bindtap="goApplyBorrow">申请借用</button>
    </view>
  </block>
</view>
