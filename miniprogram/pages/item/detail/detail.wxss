.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.detail-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.detail-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.detail-label {
  width: 120rpx;
  color: #999;
  font-size: 28rpx;
}

.detail-value {
  flex: 1;
  color: #333;
  font-size: 28rpx;
}

.stock-bar {
  display: flex;
  justify-content: space-around;
  margin-top: 24rpx;
  padding: 24rpx 0;
  background-color: #fafafa;
  border-radius: 12rpx;
}

.stock-block {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stock-num {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.stock-num.available { color: #52c41a; }
.stock-num.borrowed { color: #faad14; }
.stock-num.total { color: #1890ff; }

.stock-label {
  font-size: 24rpx;
  color: #999;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.borrower-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.borrower-name {
  font-size: 28rpx;
  color: #333;
}

.borrower-qty {
  font-size: 26rpx;
  color: #999;
}

.action-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.action-bar button {
  flex: 1;
  min-width: 45%;
  font-size: 28rpx;
  padding: 16rpx 0;
}

.borrow-bar {
  margin-top: 40rpx;
  padding: 0 20rpx;
}

.btn-borrow {
  width: 100%;
}
