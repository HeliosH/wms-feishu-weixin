.page {
  padding: 20rpx 30rpx;
  min-height: 100vh;
}

.avatar-section {
  display: flex;
  justify-content: center;
  padding: 48rpx 0;
}

.avatar-wrap {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 28rpx;
  overflow: hidden;
}

.avatar { width: 100%; height: 100%; }

.avatar-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-overlay text {
  font-size: 22rpx;
  color: #fff;
}

.info-section {
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child { border-bottom: none; }

.info-label {
  width: 120rpx;
  font-size: 28rpx;
  color: #999;
}

.info-value-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.info-edit-wrap {
  flex: 1;
  display: flex;
  align-items: center;
}

.info-value {
  font-size: 28rpx;
  color: #333;
}

.info-value.warn { color: #fa8c16; }
.info-value.status-active { color: #52c41a; }
.info-value.status-inactive { color: #ff4d4f; }

.info-input {
  flex: 1;
  font-size: 28rpx;
  border-bottom: 2rpx solid #1890ff;
  padding: 6rpx 0;
}

.info-action {
  font-size: 26rpx;
  color: #1890ff;
  padding: 4rpx 16rpx;
}

.info-action.confirm {
  color: #52c41a;
  font-weight: 600;
  margin-left: auto;
}

.info-action.cancel { color: #999; }

.info-link {
  font-size: 26rpx;
  color: #1890ff;
}

.logout-section {
  margin-top: 60rpx;
  padding: 0 20rpx;
}

.btn-logout {
  background: #fff;
  color: #ff4d4f;
  font-size: 30rpx;
  border-radius: 14rpx;
  padding: 22rpx 0;
  text-align: center;
  border: 1rpx solid #ffccc7;
}

.btn-logout::after { border: none; }
