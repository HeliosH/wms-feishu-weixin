<view class="page">
  <view class="avatar-section card">
    <view class="avatar-wrap" bindtap="onChangeAvatar">
      <image class="avatar" src="{{userInfo.avatar_url || '/images/warehouse-logo.png'}}" mode="aspectFill" />
      <view class="avatar-overlay">
        <text>换头像</text>
      </view>
    </view>
  </view>

  <view class="info-section card">
    <view class="info-row">
      <text class="info-label">姓名</text>
      <view class="info-value-wrap" wx:if="{{!editing}}">
        <text class="info-value">{{userInfo.name || '未设置'}}</text>
        <text class="info-action" bindtap="startEdit">编辑</text>
      </view>
      <view class="info-edit-wrap" wx:else>
        <input class="info-input" value="{{editName}}" bindinput="onNameInput" maxlength="20" focus />
        <text class="info-action confirm" bindtap="saveName">{{saving ? '保存中...' : '保存'}}</text>
        <text class="info-action cancel" bindtap="cancelEdit">取消</text>
      </view>
    </view>
  </view>

  <view class="info-section card">
    <view class="info-row">
      <text class="info-label">角色</text>
      <text class="info-value">{{roleLabel || '暂无角色'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">状态</text>
      <text class="info-value {{userInfo.status === 'active' ? 'status-active' : 'status-inactive'}}">
        {{userInfo.status === 'active' ? '正常' : userInfo.status === 'pending_review' ? '审批中' : userInfo.status === 'inactive' ? '已禁用' : '待激活'}}
      </text>
    </view>
  </view>

  <view class="info-section card" wx:if="{{roles.length === 0 || userInfo.status === 'pending'}}" bindtap="goApplyRole">
    <view class="info-row">
      <text class="info-label">借用权限</text>
      <view class="info-value-wrap">
        <text class="info-value warn">未开通</text>
        <text class="info-link">去申请 ›</text>
      </view>
    </view>
  </view>

  <view class="logout-section">
    <button class="btn-logout" bindtap="onLogout">退出登录</button>
  </view>
</view>
