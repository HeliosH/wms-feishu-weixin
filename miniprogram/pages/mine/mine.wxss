.page {
  padding: 20rpx 30rpx;
  padding-bottom: 140rpx;
  min-height: 100vh;
}

/* ===== 用户卡片 ===== */
.user-card {
  display: flex;
  align-items: center;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background-color: #f2f3f5;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.user-role-tag {
  font-size: 24rpx;
  color: #9aa0a6;
  margin-top: 4rpx;
}

.user-arrow {
  font-size: 40rpx;
  color: #c9cdd4;
  font-weight: 300;
}

/* ===== 申请横幅（扁平） ===== */
.apply-banner {
  display: flex;
  align-items: center;
  background: #eef6ff;
}

.apply-icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: rgba(24, 144, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.apply-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.apply-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.apply-desc {
  font-size: 24rpx;
  color: #8c9aa8;
  margin-top: 4rpx;
}

.apply-arrow {
  font-size: 36rpx;
  color: #b8c4cf;
}

/* ===== 区域 ===== */
.section {
  margin-top: 30rpx;
}

.section-title {
  font-size: 26rpx;
  color: #9aa0a6;
  font-weight: 500;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

/* ===== 菜单卡片（统一图标底色） ===== */
.menu-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}

.menu-icon-box {
  width: 60rpx;
  height: 60rpx;
  border-radius: 14rpx;
  background: #f2f4f7;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.menu-arrow {
  font-size: 32rpx;
  color: #c9cdd4;
}

.menu-divider {
  height: 1rpx;
  background-color: #f2f3f5;
}

/* ===== 退出 ===== */
.logout-section {
  margin-top: 60rpx;
}

.btn-logout {
  background: #fff;
  color: #ff4d4f;
  font-size: 30rpx;
  border-radius: 16rpx;
  padding: 22rpx 0;
  text-align: center;
  border: 1rpx solid #ffd8d6;
  line-height: 1.4;
}

.btn-logout::after {
  border: none;
}
