.page {
  padding: 20rpx 30rpx;
  padding-bottom: 140rpx;
  min-height: 100vh;
}

/* 用户卡片 */
.user-card {
  display: flex;
  align-items: center;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 22rpx;
  margin-right: 24rpx;
  background-color: #e8e8e8;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.user-role-tag {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.user-arrow {
  font-size: 40rpx;
  color: #ccc;
  font-weight: 300;
}

/* 申请横幅 */
.apply-banner {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #e6f7ff 0%, #bae7ff 100%);
  border: 1rpx solid #91d5ff;
}

.apply-icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: rgba(24, 144, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-size: 36rpx;
}

.apply-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.apply-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0050b3;
}

.apply-desc {
  font-size: 24rpx;
  color: #69c0ff;
  margin-top: 4rpx;
}

.apply-arrow {
  font-size: 36rpx;
  color: #69c0ff;
}

/* 区域 */
.section {
  margin-top: 30rpx;
}

.section-title {
  font-size: 28rpx;
  color: #999;
  font-weight: 500;
  margin-bottom: 16rpx;
  padding-left: 6rpx;
}

/* 菜单卡片 */
.menu-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}

.menu-icon-box {
  width: 60rpx;
  height: 60rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.menu-emoji {
  font-size: 28rpx;
}

.blue-bg   { background: #e6f7ff; }
.orange-bg { background: #fff7e6; }
.purple-bg { background: #f9f0ff; }

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.menu-divider {
  height: 1rpx;
  background-color: #f5f5f5;
}

/* 退出 */
.logout-section {
  margin-top: 60rpx;
}

.btn-logout {
  background: #fff;
  color: #ff4d4f;
  font-size: 30rpx;
  border-radius: 14rpx;
  padding: 22rpx 0;
  text-align: center;
  border: 1rpx solid #ffccc7;
}

.btn-logout::after {
  border: none;
}
